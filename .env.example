# =============================================================================
# AETHER ARAN IAM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file with real secrets to source control.
# =============================================================================

# 1. Google Gemini AI API Key (for NIMORA Security Copilot)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. AWS Region (Default: ap-south-1)
AWS_REGION=ap-south-1

# 3. AWS CloudTrail S3 Bucket (Optional custom bucket name for Part 1 event streaming)
CLOUDTRAIL_BUCKET_NAME=your-cloudtrail-s3-bucket-name

# 4. AWS Cognito User Pool Authentication
COGNITO_USER_POOL_ID=ap-south-1_91Wy5nlpc
COGNITO_CLIENT_ID=fnjlnnuk6gaqmp07egrddt3uo
COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_91Wy5nlpc
VITE_COGNITO_CLIENT_ID=fnjlnnuk6gaqmp07egrddt3uo
VITE_COGNITO_REGION=ap-south-1
